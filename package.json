{
  "name": "@nodefinity/react-native-music-library",
  "version": "0.10.2",
  "description": "Access local music files in React Native and get full metadata.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "browser": "./lib/module/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-music-library-example",
    "web": "yarn workspace react-native-music-library-example web",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "music",
    "library",
    "music-library",
    "react-native-music-library",
    "track",
    "song",
    "metadata",
    "retrieve",
    "tag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefinity/react-native-music-library.git"
  },
  "author": "dribble-njr <wzw15292257101@163.com> (https://github.com/dribble-njr)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nodefinity/react-native-music-library/issues"
  },
  "homepage": "https://github.com/nodefinity/react-native-music-library#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "20.4.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^2.1.1",
    "@react-native-community/cli": "20.1.3",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/eslint-config": "^0.80.3",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-builder-bob": "^0.40.8",
    "release-it": "^20.0.1",
    "turbo": "^1.10.7",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "resolutions": {
    "handlebars": "^4.7.9",
    "basic-ftp": "^5.2.2",
    "defu": "^6.1.5",
    "picomatch": "^2.3.2",
    "brace-expansion": "^2.0.3",
    "lodash": "^4.18.0",
    "ip-address": "^10.1.1",
    "type-is": "^2.0.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "fast-uri": "^3.1.2",
    "tar": "^7.5.11",
    "flatted": "^3.4.2",
    "js-yaml": "^4.1.1",
    "qs": "^6.14.2",
    "on-headers": "^1.1.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ]
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "MusicLibrarySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "ios": {
      "modulesConformingToProtocol": {
        "RCTImageURLLoader": [
          "MusicLibraryArtworkLoader"
        ]
      }
    },
    "android": {
      "javaPackageName": "com.musiclibrary"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.50.3"
  }
}
